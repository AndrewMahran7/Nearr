node_modules/
.expo/
dist/
web-build/

# Local env files — never commit real secrets.
# Allow the templates so contributors know which vars exist.
.env
.env.*
!.env.example
!transcription-service/.env.example
# Convention for archiving rotated keys locally.
.env_old
expo-config.json

*.log
.DS_Store
# Prebuild output (regenerated by `expo prebuild`). Anchored to the repo root
# so hand-written local Expo module native sources (modules/**/ios) stay under
# version control — an unanchored `ios/` also ignored the shared-auth module.
/ios/
/android/

# Python virtual environments
.venv/
**/.venv/

# Local scratch / one-off developer test artifacts (e.g. Phase 2 reel
# inspection). Never commit downloaded media, frames, transcripts, or any
# response that may contain signed URLs / secrets.
.tmp/

# Recognition audit raw output — contains real user-shared source URLs.
# Summaries for sharing use audit IDs only; raw records stay local.
artifacts/recognition-audit/
