{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nearr.local/schema/recognition-gold-manifest-v1",
  "title": "Recognition gold source manifest record",
  "type": "object",
  "required": ["case_id", "source_group_id", "platform", "source_public_id", "source_url_reference", "retrieval_date", "categories", "evidence", "answer_spans", "view_eligibility", "state", "exposure"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^g_[a-f0-9]{16}$" },
    "source_group_id": { "type": "string", "pattern": "^sg_[a-f0-9]{16}$" },
    "platform": { "enum": ["instagram", "tiktok", "youtube", "facebook", "other"] },
    "source_public_id": { "type": ["string", "null"] },
    "source_url_reference": { "type": ["string", "null"], "format": "uri" },
    "retrieval_date": { "type": ["string", "null"], "format": "date" },
    "inventoried_at": { "type": "string", "format": "date" },
    "source_record_date": { "type": ["string", "null"], "format": "date" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "geography": { "type": ["object", "null"], "description": "Research metadata; never forwarded to inference without an explicit evidence field." },
    "evidence": {
      "type": "object",
      "properties": {
        "caption": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "hashtags": { "type": "array", "items": { "type": "string" } },
        "tagged_accounts": { "type": "array", "items": { "type": "string" } },
        "location_tag": { "type": ["string", "null"] },
        "source_geography": { "type": ["object", "null"], "properties": { "country": { "type": ["string", "null"] }, "region": { "type": ["string", "null"] }, "city": { "type": ["string", "null"] } }, "additionalProperties": false },
        "transcript": { "type": ["string", "null"] },
        "transcript_source": { "enum": ["spoken_audio", null], "description": "Required with visual_audio; transcript must come from speech in the video, never caption text." },
        "frame_paths": { "type": "array", "items": { "type": "string" }, "description": "Local temporary paths; materializer re-encodes into neutral names. Do not commit media." },
        "frame_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "description": "Required for each held-out frame; seal verifies bytes exist and match." },
        "pixel_text_masked_frame_paths": { "type": "array", "items": { "type": "string" }, "description": "Optional reviewed derivatives for the separate OCR ablation. The normal visual_only view uses original frames, including legitimate in-video text." },
        "pixel_text_masked_frame_sha256": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
      },
      "additionalProperties": true
    },
    "answer_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "start", "end", "kind"],
        "properties": {
          "field": { "enum": ["caption", "description", "hashtags", "tagged_accounts", "location_tag", "source_geography", "transcript"] },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 1 },
          "kind": { "type": "string" }
        },
        "additionalProperties": false
      },
      "description": "Offsets and categories only; do not repeat answer text here."
    },
    "view_eligibility": {
      "type": "object",
      "required": ["full", "description_hidden", "location_hidden", "visual_only", "text_only"],
      "properties": {
        "full": { "type": "boolean" },
        "description_hidden": { "type": "boolean" },
        "location_hidden": { "type": "boolean" },
        "visual_audio": { "type": "boolean" },
        "visual_only": { "type": "boolean" },
        "visual_pixel_text_masked": { "type": "boolean" },
        "text_only": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "visual_answer_overlay": { "type": "boolean", "description": "Whether original video pixels visibly state the answer. This does not disqualify normal visual_only." },
    "visual_review": { "type": "object", "description": "Required for READY: inspected complete video, with retained frames spanning opening, middle and ending.", "required": ["duration_seconds", "frame_timestamps_seconds", "coverage", "entire_video_inspected", "reviewer", "reviewed_at"], "properties": { "duration_seconds": { "type": "number", "exclusiveMinimum": 0 }, "frame_timestamps_seconds": { "type": "array", "minItems": 3, "items": { "type": "number", "minimum": 0 } }, "coverage": { "type": "array", "items": { "enum": ["opening", "middle", "ending", "scene_change", "distinct_segment"] } }, "entire_video_inspected": { "type": "boolean" }, "reviewer": { "type": "string" }, "reviewed_at": { "type": "string", "format": "date-time" } }, "additionalProperties": true },
    "mask_review": { "type": "object", "properties": { "answer_fields_checked": { "type": "boolean" }, "permitted_media_derivative": { "type": "boolean" }, "pixel_text_mask_verified": { "type": "boolean" }, "reviewer": { "type": "string" }, "reviewed_at": { "type": "string", "format": "date-time" } }, "additionalProperties": true },
    "state": { "enum": ["candidate", "ready"] },
    "exposure": { "enum": ["new_unscored", "historical_outcomes_already_exposed"] }
  },
  "additionalProperties": true
}
