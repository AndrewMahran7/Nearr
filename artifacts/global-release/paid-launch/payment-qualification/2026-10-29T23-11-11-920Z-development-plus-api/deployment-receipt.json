  "configTriggers": [
    {
      "definition": "CREATE TRIGGER nearr_free_only_activation BEFORE INSERT OR UPDATE ON public.nearr_plus_config FOR EACH ROW EXECUTE FUNCTION guard_nearr_free_only_activation()",
      "function_definition": "CREATE OR REPLACE FUNCTION public.guard_nearr_free_only_activation()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\r\nbegin\r\n  if current_setting('transaction_isolation')<>'read committed' then\r\n    raise exception 'plus_release_requires_read_committed'; end if;\r\n  perform pg_advisory_xact_lock(hashtextextended('nearr_plus_release_policy',0));\r\n  if new.release_mode='free_only' and (tg_op='INSERT' or old.release_mode<>'free_only') and (\r\n    exists(select 1 from public.nearr_plus_customers) or exists(select 1 from public.nearr_plus_entitlements)\r\n  ) then raise exception 'free_only_existing_paid_history'; end if;\r\n  return new;\r\nend $function$\n",
      "tgname": "nearr_free_only_activation"
    },
    {
      "definition": "CREATE TRIGGER nearr_paid_launch_activation BEFORE UPDATE ON public.nearr_plus_config FOR EACH ROW EXECUTE FUNCTION guard_nearr_paid_launch_activation()",
      "function_definition": "CREATE OR REPLACE FUNCTION public.guard_nearr_paid_launch_activation()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nbegin\n  perform public.nearr_paid_lock();\n  if new.paid_find_policy_enabled and not old.paid_find_policy_enabled then\n    if exists(select 1 from public.token_monetization_config where enabled) then raise exception 'legacy_token_experiment_must_be_disabled'; end if;\n    if exists(select 1 from public.place_find_reservations where status='reserved')\n      or exists(select 1 from public.nearr_plus_recognitions where state='reserved') then raise exception 'legacy_reservations_require_reconciliation'; end if;\n    if new.revenuecat_project_id is null or jsonb_typeof(new.revenuecat_token_product_ids)<>'object'\n      or (select count(*) from jsonb_each_text(new.revenuecat_token_product_ids))<>3\n      or exists(select 1 from (values('com.nearr.tokens.20.v2'),('com.nearr.tokens.50.v2'),('com.nearr.tokens.200.v2')) p(id)\n        where nullif(new.revenuecat_token_product_ids->>p.id,'') is null)\n      then raise exception 'paid_recovery_catalog_required'; end if;\n  end if;\n  return new;\nend $function$\n",
      "tgname": "nearr_paid_launch_activation"
    }
  ],
