{
  "name": "nearr-media-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nearr Phase 2 media-analysis worker. Retrieves public social video temporarily, extracts spoken + visible place evidence, and hands it to Nearr's existing deterministic resolver. Isolated from the Expo app dependency graph.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "node --import tsx --test \"tests/integration/e2e.test.ts\"",
    "test:e2e-local": "node --import tsx --test \"tests/integration/e2e.test.ts\"",
    "test:media-worker-live": "node --import tsx --test \"tests/live/mediaWorker.live.test.ts\"",
    "test:instagram-resolver-live": "node --import tsx --test \"tests/live/instagramResolver.live.test.ts\"",
    "test:native-video-live": "node --import tsx --test \"tests/live/nativeVideo.live.test.ts\"",
    "media:inspect": "node --import tsx src/cli/inspectUrl.ts",
    "vayrin:geo": "node --import tsx src/cli/vayrinGeolocate.ts",
    "fixtures:generate": "node --import tsx tests/support/generateSyntheticMedia.ts",
    "benchmark:concurrency": "node --import tsx tests/support/concurrencyBenchmark.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "~5.5.0"
  }
}
