# Nearr media worker — environment (SERVER-ONLY; never EXPO_PUBLIC_*).
# Copy to .env for local development. NEVER commit real secrets.

# ---- Required ----
# Dedicated invocation secret the DB wake-up / cron presents (Bearer). This is
# NOT the service-role key.
SHARE_MEDIA_WORKER_SECRET=

# Supabase service role — used INTERNALLY only (DB access).
# Never logged, never returned to clients, never sent via pg_net.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# process-share-jobs finalize endpoint. Defaults to
# ${SUPABASE_URL}/functions/v1/process-share-jobs if unset.
SHARE_JOBS_FINALIZE_URL=
# Dedicated bearer for the finalize callback (verifyPlaceEvidence). NOT the
# service-role key — independent so a service-role rotation can never
# silently break this callback. Must match process-share-jobs's
# MEDIA_FINALIZE_SECRET Edge Function secret.
MEDIA_FINALIZE_SECRET=

# ---- Feature flags (default OFF) ----
MEDIA_FALLBACK_ENABLED=false
INSTAGRAM_MEDIA_RESOLVER_ENABLED=false
TIKTOK_MEDIA_RESOLVER_ENABLED=false
YOUTUBE_MEDIA_RESOLVER_ENABLED=false
FACEBOOK_MEDIA_RESOLVER_ENABLED=false
SNAPCHAT_MEDIA_RESOLVER_ENABLED=false
NATIVE_VIDEO_ANALYSIS_ENABLED=false
# Paid ScrapeCreators tail fallbacks. Server-only and default OFF.
SCRAPECREATORS_TIKTOK_FALLBACK_ENABLED=false
SCRAPECREATORS_INSTAGRAM_FALLBACK_ENABLED=false
# Paid Facebook tail fallback. Requires a stable canonical numeric video ID.
SCRAPECREATORS_FACEBOOK_FALLBACK_ENABLED=false

# ---- Server ----
PORT=8090

# ---- Concurrency / claiming ----
MEDIA_WORKER_MAX_CONCURRENCY=1
MEDIA_WORKER_CLAIM_BATCH=1
MEDIA_WORKER_CLAIM_LOCK_SECONDS=600

# ---- Media limits (see README for why each default was chosen) ----
MEDIA_MAX_DURATION_SECONDS=180
MEDIA_MAX_DOWNLOAD_BYTES=157286400
MEDIA_DOWNLOAD_TIMEOUT_MS=60000
MEDIA_JOB_TIMEOUT_MS=480000
MEDIA_MAX_SELECTED_FRAMES=24
MEDIA_FRAME_INTERVAL_SECONDS=1
MEDIA_REDIRECT_LIMIT=3

# Comma-separated host allowlist for outbound media fetches (HTTPS only).
# Default already covers every wired resolver's video CDN + (for YouTube)
# caption endpoint — override only to narrow it or add a new provider.
MEDIA_ALLOWED_HOSTS=cdninstagram.com,fbcdn.net,instagram.com,googlevideo.com,youtube.com,tiktokcdn.com,tiktokcdn-us.com,tiktokcdn-eu.com,tiktokv.com,tiktokv.us,tiktokv.eu,byteoversea.com,ibytedtos.com,tiktok.com,muscdn.com,sc-cdn.net

# ---- Providers ----
# transcription: noop (default) | openai | self_hosted
#   openai      → OpenAI-compatible Whisper (uploads the extracted audio file).
#   self_hosted → URL-based service (the repo's evidence-server FastAPI:
#                 POST /extract/video-transcript {url,platform}). Needs the
#                 PUBLIC source URL, so it only runs in `media:inspect --url`
#                 mode, not --file mode.
# If MEDIA_TRANSCRIPTION_PROVIDER is unset, the worker bridges the app-level
# TRANSCRIPTION_PROVIDER (self_hosted → self_hosted; anything else → noop).
MEDIA_TRANSCRIPTION_PROVIDER=noop
MEDIA_TRANSCRIPTION_API_KEY=
MEDIA_TRANSCRIPTION_MODEL=whisper-1
# self_hosted transcription (bridged from the existing root .env vars). The
# adapter loads these automatically; it stays inert until BOTH a real https URL
# and a non-placeholder key are set (the shipped "api_key" placeholder is
# ignored). Smallest config to enable: point the URL at a running evidence-server
# and set a real service key.
# SELF_HOSTED_TRANSCRIPTION_URL=https://your-evidence-server
# TRANSCRIPTION_SERVICE_API_KEY=your-real-key
# analysis: heuristic (default) | gemini
MEDIA_ANALYSIS_PROVIDER=heuristic
GEMINI_API_KEY=
# Retirement-proof default; pin an explicit model (e.g. gemini-2.5-flash) if you
# need a fixed version. gemini-1.5-flash is retired and returns HTTP 404.
GEMINI_MODEL=gemini-flash-latest
# ocr: noop (default) | model
MEDIA_OCR_PROVIDER=noop

# ---- Vayrin verification V3 (server-only, default OFF) ----
VAYRIN_VERIFICATION_V3_ENABLED=false
GOOGLE_PLACES_KEY=
VAYRIN_REGION_POI_CANDIDATE_LIMIT=8

# Shared ScrapeCreators fallback credential. Railway worker only; never use an
# EXPO_PUBLIC_ name and never expose it to mobile or Edge client code.
SCRAPE_CREATORS_KEY=

# ---- Optional public-media fallback provider (local inspector / worker) ----
# Used ONLY when the direct yt-dlp fetch can't retrieve PUBLIC content and you
# have a documented, verified public-media fetch service (e.g. a self-hosted
# Cobalt instance). Provider-neutral: the endpoint returns JSON containing a
# DIRECT https media URL, which is then downloaded through the same SSRF-guarded,
# size-capped downloader. Public content only — never used for private/login
# content. Leave MEDIA_FETCH_PROVIDER_URL empty to disable.
MEDIA_FETCH_PROVIDER_URL=
MEDIA_FETCH_PROVIDER_API_KEY=
# Header used to send the API key (default: authorization => "Bearer <key>").
MEDIA_FETCH_PROVIDER_AUTH_HEADER=authorization
# Query param the source URL is appended as (default: url).
MEDIA_FETCH_PROVIDER_URL_PARAM=url
# Dot-path to the direct media URL in the JSON response (default: url; e.g. data.url).
MEDIA_FETCH_PROVIDER_RESULT_PATH=url

# ---- External binaries (override for local dev if not on PATH) ----
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Temp storage ----
MEDIA_TEMP_DIR=

# ---- Parent-job park lease (also read by the Deno worker) ----
MEDIA_PARENT_LEASE_SECONDS=1200
